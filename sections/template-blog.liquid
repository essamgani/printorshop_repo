{% paginate blog.articles by 3 %}
    {% for product in blog.artilces %}
        <div>
            {% if article.image %}
                <img src="{{ article.image | image_url: 'medium' }}" alt="{{ article.image.alt }}" width="" height="">
            {% else %}
                {{ 'image' | placeholder_svg_tag }}
            {% endif %}
        </div>
    {% endfor %}
{% endpaginate %}